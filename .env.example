# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# TradingView Data API (recommended). Get a Console key:
# https://www.tradingviewapi.com/
TRADINGVIEW_API_KEY=
# Legacy RapidAPI names still work as Console credentials.
#TRADINGVIEW_RAPIDAPI_KEY=
#RAPIDAPI_KEY=
# Opt in to the RapidAPI host instead of Console:
#TRADINGVIEW_BACKEND=rapid

# Optional Redis L2 cache for identical TradingView HTTP requests.
# Default is an in-process memory TTL cache. Redis is not required.
#REDIS_URL=redis://127.0.0.1:6379/0
#TRADINGVIEW_CACHE_ENABLED=true

# FRED (Federal Reserve macro data). Free key:
# https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Optional: OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp, relay).
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (pip install ".[bedrock]")
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2

# Remote Ollama (default is http://localhost:11434/v1)
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# TRADINGAGENTS_* overrides for DEFAULT_CONFIG
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.5
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
#TRADINGAGENTS_TEMPERATURE=0.0
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Optional China / US vendor chains (default: disabled; TradingView-first)
#TRADINGAGENTS_CN_DATA_VENDORS=disabled
#TRADINGAGENTS_US_DATA_VENDORS=disabled

# Optional China-market extras: pip install ".[china-data]"
#TUSHARE_TOKEN=
#FINNHUB_API_KEY=
